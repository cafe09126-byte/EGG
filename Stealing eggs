-- ฟังก์ชันสร้างปุ่มเปิด/ปิด (Toggle)
local function CreateToggle(name, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 280, 0, 35)
    btn.Position = UDim2.new(0.5, -140, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.Gotham
    btn.Text = name .. ": ปิด"
    btn.Parent = MainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            btn.Text = name .. ": เปิด"
        else
            btn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            btn.Text = name .. ": ปิด"
        end
        callback(state)
    end)
end

-- ฟังก์ชันสร้างช่องปรับค่าความเร็ว (Slider แบบกล่องข้อความพิมพ์ตัวเลข)
local function CreateSpeedBox(yPos, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 280, 0, 20)
    label.Position = UDim2.new(0.5, -140, 0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.Text = "ความเร็วบิน (1 - 1,000):"
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = MainFrame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 280, 0, 30)
    box.Position = UDim2.new(0.5, -140, 0, yPos + 22)
    box.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 14
    box.Font = Enum.Font.Gotham
    box.Text = "50"
    box.Parent = MainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = box

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            if val < 1 then val = 1 end
            if val > 1000 then val = 1000 end
            box.Text = tostring(val)
            callback(val)
        else
            box.Text = tostring(EggSettings.FlightSpeed)
        end
    end)
end

-- ฟังก์ชันสร้างปุ่มเลือกระดับไข่ (วนเปลี่ยนระดับ)
local function CreateTierSelector(yPos, callback)
    local tiers = {"ศักดิ์สิทธิ์", "นิรันดร์", "ความลับ"}
    local currentIndex = 1

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 280, 0, 35)
    btn.Position = UDim2.new(0.5, -140, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(155, 89, 182)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.Text = "ระดับไข่: " .. tiers[currentIndex]
    btn.Parent = MainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #tiers then
            currentIndex = 1
        end
        local chosen = tiers[currentIndex]
        btn.Text = "ระดับไข่: " .. chosen
        callback(chosen)
    end)
end

