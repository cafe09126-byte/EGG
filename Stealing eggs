--[                  ระบบการทำงานเบื้องหลัง                    ]
--[========================================================]

RunService.RenderStepped:Connect(function()
    local character = Player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = character.HumanoidRootPart

    -- ฟังก์ชันจำลองการบินไปขโมยไข่ (ตามความเร็วที่ปรับ 1-1,000)
    if EggSettings.Flying then
        -- ขยับตัวละครลอยตัวหรือพุ่งไปข้างหน้าตามทิศทางกล้อง
        local camera = workspace.CurrentCamera
        rootPart.Velocity = camera.CFrame.LookVector * (EggSettings.FlightSpeed * 0.5)
    end

    -- ฟังก์ชันหยิบไข่เร็วและการกรองเลือกระดับไข่ (ศักดิ์สิทธิ์, นิรันดร์, ความลับ)
    if EggSettings.FastPick then
        for _, obj in ipairs(workspace:GetDescendants()) do
            -- ค้นหาวัตถุที่เป็นไข่ตามระดับที่เลือก
            if obj:IsA("Model") or obj:IsA("Part") then
                if string.find(obj.Name:lower(), "egg") or string.find(obj.Name:lower(), "ไข่") then
                    -- ตรวจสอบระดับตามที่ผู้ใช้ตั้งค่า (ศักดิ์สิทธิ์, นิรันดร์, ความลับ)
                    if string.find(obj.Name, EggSettings.SelectedTier) then
                        -- จำลองการดึงไข่เข้ามาหาตัวหรือกดหยิบอัตราเร่งด่วน
                        if obj:IsA("Part") then
                            obj.CFrame = rootPart.CFrame
                        elseif obj:FindFirstChildWhichIsA("BasePart") then
                            obj:SetPrimaryPartCFrame(rootPart.CFrame)
                        end
                    end
                end
            end
        end
    end
end)

